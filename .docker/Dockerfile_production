# Base image
FROM node:24 AS build

# Set the working directory in the container
WORKDIR /app

# copy src (secrets are excluded by .dockerignore)
COPY .. .

# install pnpm
RUN npm install -g pnpm

# install dependencies exactly as locked
RUN pnpm install --frozen-lockfile

# build (vite build, then merges dist/ into public/)
RUN node build


#pull nginx as webser and load balancer
FROM nginx:stable-alpine3.20-slim

RUN apk update && apk upgrade --no-cache

# RabbitGram: security headers (see .docker/nginx.conf)
COPY .docker/nginx.conf /etc/nginx/conf.d/default.conf

# copy the build output of the stage above (not the stale committed public/)
COPY --from=build /app/public /usr/share/nginx/html
